# Qwikly — environment variables
# Copy this file to .env.local for local dev, and set the same vars on Vercel.
# Lines marked with NEXT_PUBLIC_* are exposed to the browser.

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.qwikly.co.za

# ── Qwikly owner tenant ───────────────────────────────────────────────────────
# Numeric clients.id of the Qwikly-owned tenant that runs the marketing site
# chat (qwikly.co.za itself). Used to skip trial-expiry checks, override the
# notification recipient, and so on. Default is "1" if unset.
QWIKLY_OWNER_CLIENT_ID=1
# Optional: route lead notifications for the owner tenant to a custom inbox
# instead of whatever lives in the businesses row.
QWIKLY_OWN_NOTIFICATION_EMAIL=

# Public mirror used by the contact-page demo widget on the landing site.
NEXT_PUBLIC_QWIKLY_OWNER_CLIENT_ID=1

# ── Resend (email) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
# Default From: address; falls back to a hardcoded value if unset.
RESEND_FROM=

# ── Anthropic / OpenAI (chat assistant) ───────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Cron ──────────────────────────────────────────────────────────────────────
# Required header secret for /api/cron/* invocations.
CRON_SECRET=

# ── Paystack ──────────────────────────────────────────────────────────────────
# See .env.paystack.template for the full list (plan codes, webhook secret).
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ── Yoco (legacy) ─────────────────────────────────────────────────────────────
YOCO_SECRET_KEY=
YOCO_WEBHOOK_SECRET=
